# Telegram bot token from @BotFather (see bot/README.md)
TELEGRAM_BOT_TOKEN=

# LLM provider — set ONE of these:
# Preferred: Anthropic API key (console.anthropic.com) — enables prompt caching
# (much cheaper: the bot's system prompt is ~25KB) and refusal fallbacks.
ANTHROPIC_API_KEY=
# Fallback: OpenRouter key (sk-or-v1-...) — routes to Claude models via
# OpenRouter's API. No prompt caching; full system prompt billed every message.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5   # pick any slug from openrouter.ai/models

# Optional overrides
# VAULT_DIR=/Users/you/cn-crypto-narratives
# CLAUDE_MODEL=claude-opus-5
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
